{
  "schemaVersion": 1,
  "id": "songmod",
  "version": "${version}",
  "name": "点歌 Mod",
  "description": "在聊天里发 [点歌]歌名：机器人用会员账号解析后私聊把播放数据发给你，本 Mod 负责播放（谁点谁听，不打扰别人）；机器人不在线时本地兜底自己搜网易云。服务端无需任何改动。",
  "authors": [
    "QingCheng3962"
  ],
  "contact": {
    "homepage": "https://github.com/QingCheng3962/AI-Helper-In-Minecraft"
  },
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.qingcheng.songmod.SongModClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_min}",
    "fabric-api": "*"
  }
}
